name: Update IPTV Playlist

on:
  workflow_dispatch:
  schedule:
    - cron: "0 5 * * *"

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Download playlists
        shell: bash
        run: |
          set -u

          get() {
            url="$1"
            file="$2"

            echo "Download: $file"

            if ! curl -fL \
              --retry 2 \
              --connect-timeout 15 \
              --max-time 120 \
              "$url" \
              -o "$file"
            then
              echo "Quelle nicht erreichbar: $url"
              printf '#EXTM3U\n' > "$file"
            fi
          }

          get "https://iptv-org.github.io/iptv/countries/de.m3u" de.m3u
          get "https://iman-py.github.io/open-tv-atlas/playlists/deu/hd.m3u" de-hd.m3u

          get "https://raw.githubusercontent.com/Free-TV/IPTV/master/playlists/playlist_germany.m3u8" de-free.m3u

          get "https://raw.githubusercontent.com/iptv-org/iptv/master/streams/de_pluto.m3u" de-pluto.m3u
          get "https://raw.githubusercontent.com/iptv-org/iptv/master/streams/de_rakuten.m3u" de-rakuten.m3u
          get "https://raw.githubusercontent.com/iptv-org/iptv/master/streams/de_samsung.m3u" de-samsung.m3u

          get "https://iptv-org.github.io/iptv/countries/ir.m3u" ir.m3u
          get "https://iptv-org.github.io/iptv/languages/fas.m3u" fas.m3u

          get "https://raw.githubusercontent.com/Free-TV/IPTV/master/playlists/playlist_iran.m3u8" ir-free.m3u

          get "https://raw.githubusercontent.com/shayanline/iptv-iran/main/playlists/iran-global.m3u" ir-global.m3u

          get "https://raw.githubusercontent.com/shayanline/iptv-iran/main/playlists/categories/sat-music.m3u" ir-music.m3u

          get "https://raw.githubusercontent.com/shayanline/iptv-iran/main/playlists/categories/sat-movies.m3u" ir-movies.m3u

          get "https://raw.githubusercontent.com/iptv-org/iptv/master/streams/ir_telewebion.m3u" telewebion.m3u

      - name: Build playlist
        shell: python
        run: |
          import re
          from pathlib import Path

name: Update IPTV Playlist

on:
  workflow_dispatch:
  schedule:
    - cron: "0 5 * * *"

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # =====================================================
      # PLAYLISTEN LADEN
      # =====================================================
      - name: Download playlists
        shell: bash
        run: |
          set -u

          get() {
            url="$1"
            file="$2"

            echo "Lade: $file"

            if curl \
              --fail \
              --location \
              --retry 3 \
              --retry-delay 2 \
              --connect-timeout 20 \
              --max-time 120 \
              --show-error \
              "$url" \
              --output "$file"
            then
              count=$(grep -c '^#EXTINF:' "$file" || true)
              echo "Erfolgreich: $file ($count Sender)"
            else
              echo "Quelle nicht erreichbar: $url"
              printf '#EXTM3U\n' > "$file"
            fi
          }

          # -----------------------------
          # DEUTSCHLAND
          # -----------------------------

          get \
          "https://iptv-org.github.io/iptv/countries/de.m3u" \
          "de.m3u"

          # Deutsche HD-Quelle
          get \
          "https://iman-py.github.io/open-tv-atlas/playlists/deu/hd.m3u" \
          "de-hd.m3u"

          # Free-TV Germany
          get \
          "https://raw.githubusercontent.com/Free-TV/IPTV/master/playlists/playlist_germany.m3u8" \
          "de-free.m3u"

          # german-tv-m3u - neue Quelle
          get \
          "https://raw.githubusercontent.com/josxha/german-tv-m3u/main/german-tv.m3u" \
          "de-germantv.m3u"

          # Deutsche FAST-Sender
          get \
          "https://raw.githubusercontent.com/iptv-org/iptv/master/streams/de_pluto.m3u" \
          "de-pluto.m3u"

          get \
          "https://raw.githubusercontent.com/iptv-org/iptv/master/streams/de_rakuten.m3u" \
          "de-rakuten.m3u"

          get \
          "https://raw.githubusercontent.com/iptv-org/iptv/master/streams/de_samsung.m3u" \
          "de-samsung.m3u"


          # -----------------------------
          # IRAN / PERSISCH
          # -----------------------------

          get \
          "https://iptv-org.github.io/iptv/countries/ir.m3u" \
          "ir.m3u"

          get \
          "https://iptv-org.github.io/iptv/languages/fas.m3u" \
          "fas.m3u"

          # Free-TV Iran
          get \
          "https://raw.githubusercontent.com/Free-TV/IPTV/master/playlists/playlist_iran.m3u8" \
          "ir-free.m3u"

          # Telewebion
          get \
          "https://raw.githubusercontent.com/iptv-org/iptv/master/streams/ir_telewebion.m3u" \
          "telewebion.m3u"

          # Iran Global
          get \
          "https://raw.githubusercontent.com/shayanline/iptv-iran/main/playlists/iran-global.m3u" \
          "ir-global.m3u"

          # Persische Musik
          get \
          "https://raw.githubusercontent.com/shayanline/iptv-iran/main/playlists/categories/sat-music.m3u" \
          "ir-music.m3u"

          # Persische Filme
          get \
          "https://raw.githubusercontent.com/shayanline/iptv-iran/main/playlists/categories/sat-movies.m3u" \
          "ir-movies.m3u"


      # =====================================================
      # PLAYLIST ERSTELLEN
      # =====================================================
      - name: Build categorized playlist
        shell: bash
        run: |
          python3 <<'PY'

          import re
          from pathlib import Path

          OUTPUT = Path("TV-Deutschland-Iran-Persisch.m3u")

          SOURCES = [
              # Deutschland
              ("de.m3u", "DE"),
              ("de-hd.m3u", "DEHD"),
              ("de-free.m3u", "DE"),
              ("de-germantv.m3u", "DE"),
              ("de-pluto.m3u", "DEFAST"),
              ("de-rakuten.m3u", "DEFAST"),
              ("de-samsung.m3u", "DEFAST"),

              # Iran / Persisch
              ("ir.m3u", "IR"),
              ("fas.m3u", "IR"),
              ("ir-free.m3u", "IR"),
              ("telewebion.m3u", "TELEWEBION"),
              ("ir-global.m3u", "IR"),
              ("ir-music.m3u", "IRMUSIC"),
              ("ir-movies.m3u", "IRMOVIES"),
          ]


          def parse_m3u(path):
              if not Path(path).exists():
                  return []

              text = Path(path).read_text(
                  encoding="utf-8",
                  errors="ignore"
              )

              lines = text.splitlines()
              entries = []

              i = 0

              while i < len(lines):

                  line = lines[i].strip()

                  if not line.startswith("#EXTINF:"):
                      i += 1
                      continue

                  metadata = line
                  options = []

                  i += 1

                  while i < len(lines):

                      current = lines[i].strip()

                      if not current:
                          i += 1
                          continue

                      if current.startswith("#EXTINF:"):
                          break

                      if current.startswith("#"):
                          options.append(current)
                          i += 1
                          continue

                      url = current

                      entries.append(
                          {
                              "metadata": metadata,
                              "options": options,
                              "url": url,
                          }
                      )

                      i += 1
                      break

              return entries


          def sender_name(metadata):
              if "," in metadata:
                  return metadata.rsplit(",", 1)[-1].strip()

              return "Unbekannt"


          def normalize(value):
              value = value.casefold()

              value = re.sub(
                  r"\b(hd|fhd|uhd|4k|1080p|720p)\b",
                  "",
                  value
              )

              value = re.sub(
                  r"[^a-z0-9äöüß]+",
                  "",
                  value
              )

              return value


          def classify(name

name: Update IPTV Playlist

on:
  workflow_dispatch:
  schedule:
    - cron: "0 5 * * *"

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      # =====================================================
      # DOWNLOAD SOURCES
      # =====================================================
      - name: Download playlists
        shell: bash
        run: |
          set -u

          get() {
            url="$1"
            file="$2"

            echo "------------------------------------------------"
            echo "Lade: $file"
            echo "Quelle: $url"

            if curl \
              --fail \
              --location \
              --retry 3 \
              --retry-delay 2 \
              --connect-timeout 20 \
              --max-time 120 \
              --user-agent "Mozilla/5.0 IPTV-Playlist-Updater" \
              --show-error \
              "$url" \
              --output "$file"
            then

              channels=$(grep -c '^#EXTINF:' "$file" || true)

              if [ "$channels" -gt 0 ]; then
                echo "OK: $file ($channels Sender)"
              else
                echo "WARNUNG: Keine Sender gefunden: $file"
                printf '#EXTM3U\n' > "$file"
              fi

            else
              echo "WARNUNG: Quelle nicht erreichbar."
              printf '#EXTM3U\n' > "$file"
            fi
          }

          # =================================================
          # DEUTSCHLAND
          # =================================================

          get \
          "https://iptv-org.github.io/iptv/countries/de.m3u" \
          "de.m3u"

          get \
          "https://iman-py.github.io/open-tv-atlas/playlists/deu/hd.m3u" \
          "de-hd.m3u"

          get \
          "https://raw.githubusercontent.com/Free-TV/IPTV/master/playlists/playlist_germany.m3u8" \
          "de-free.m3u"

          # German TV
          get \
          "https://raw.githubusercontent.com/josxha/german-tv-m3u/main/german-tv.m3u" \
          "de-germantv.m3u"

          # Celluloid TV
          get \
          "https://gist.githubusercontent.com/Axel-Erfurt/b40584d152e1c2f13259590a135e05f4/raw/celluloidTV.m3u" \
          "de-celluloid.m3u"

          # FAST
          get \
          "https://raw.githubusercontent.com/iptv-org/iptv/master/streams/de_pluto.m3u" \
          "de-pluto.m3u"

          get \
          "https://raw.githubusercontent.com/iptv-org/iptv/master/streams/de_rakuten.m3u" \
          "de-rakuten.m3u"

          get \
          "https://raw.githubusercontent.com/iptv-org/iptv/master/streams/de_samsung.m3u" \
          "de-samsung.m3u"


          # =================================================
          # IRAN / PERSISCH
          # =================================================

          get \
          "https://iptv-org.github.io/iptv/countries/ir.m3u" \
          "ir.m3u"

          get \
          "https://iptv-org.github.io/iptv/languages/fas.m3u" \
          "fas.m3u"

          get \
          "https://raw.githubusercontent.com/Free-TV/IPTV/master/playlists/playlist_iran.m3u8" \
          "ir-free.m3u"

          # Telewebion
          get \
          "https://raw.githubusercontent.com/iptv-org/iptv/master/streams/ir_telewebion.m3u" \
          "telewebion.m3u"

          # Iran Global
          get \
          "https://raw.githubusercontent.com/shayanline/iptv-iran/main/playlists/iran-global.m3u" \
          "ir-global.m3u"

          # Persian Music
          get \
          "https://raw.githubusercontent.com/shayanline/iptv-iran/main/playlists/categories/sat-music.m3u" \
          "ir-music.m3u"

          # Persian Movies
          get \
          "https://raw.githubusercontent.com/shayanline/iptv-iran/main/playlists/categories/sat-movies.m3u" \
          "ir-movies.m3u"


      # =====================================================
      # BUILD PLAYLIST
      # =====================================================
      - name: Build categorized playlist
        shell: bash
        run: |
          set -euo pipefail

          python3 <<'PY'
          import re
          from pathlib import Path

          OUTPUT = Path("TV-Deutschland-Iran-Persisch.m3u")


          # =================================================
          # SOURCES
          # =================================================

          SOURCES = [

              # Germany
              ("de.m3u", "DE"),
              ("de-hd.m3u", "DEHD"),
              ("de-free.m3u", "DE"),
              ("de-germantv.m3u", "DE"),
              ("de-celluloid.m3u", "DE"),

              # German FAST
              ("de-pluto.m3u", "DEFAST"),
              ("de-rakuten.m3u", "DEFAST"),
              ("de-samsung.m3u", "DEFAST"),

              # Iran / Persian
              ("ir.m3u", "IR"),
              ("fas.m3u", "IR"),
              ("ir-free.m3u", "IR"),

              # Telewebion
              ("telewebion.m3u", "TELEWEBION"),

              # Additional Persian
              ("ir-global.m3u", "IR"),
              ("ir-music.m3u", "IRMUSIC"),
              ("ir-movies.m3u", "IRMOVIES"),
          ]


          # =================================================
          # PARSE M3U
          # =================================================

          def parse_m3u(path):

              path = Path(path)

              if not path.exists():
                  return []

              text = path.read_text(
                  encoding="utf-8",
                  errors="ignore"
              )

              lines = text.splitlines()

              entries = []

              i = 0

              while i < len(lines):

                  line = lines[i].strip()

                  if not line.startswith("#EXTINF:"):
                      i += 1
                      continue

                  metadata = line

                  options = []

                  url = None

                  i += 1

                  while i < len(lines):

                      current = lines[i].strip()

                      if not current:
                          i += 1
                          continue

                      # New channel starts before a URL was found.
                      if current.startswith("#EXTINF:"):
                          break

                      # Preserve channel-specific options.
                      if current.startswith("#"):
                          options.append(current)
                          i += 1
                          continue

                      url = current

                      i += 1
                      break

                  if url:

                      entries.append(
                          {
                              "metadata": metadata,
                              "options": options,
                              "url": url,
                          }
                      )

              return entries


          # =================================================
          # CHANNEL NAME
          # =================================================

          def sender_name(metadata):

              if "," in metadata:

                  name = metadata.rsplit(",", 1)[-1].strip()

                  if name:
                      return name

              return "Unbekannt"


          # =================================================
          # NORMALIZATION
          # =================================================

          def normalize(value):

              value = value.casefold()

              value = re.sub(
                  r"\b(hd|fhd|uhd|4k|1080p|720p)\b",
                  "",
                  value
              )

              value = re.sub(
                  r"[^a-z0-9äöüß]+",
                  "",
                  value
              )

              return value


          # =================================================
          # CATEGORY
          # =================================================

          def classify(name, source):

              text = name.casefold()


              # -------------------------------------------------
              # TELEWEBION
              # -------------------------------------------------

              if source == "TELEWEBION":

                  if any(x in text for x in [
                      "news",
                      "khabar",
                      "خبر",
                  ]):
                      return "Persisch | News"

                  if any(x in text for x in [
                      "sport",
                      "varzesh",
                      "ورزش",
                  ]):
                      return "Persisch | Sport"

                  if any(x in text for x in [
                      "pooya",
                      "nahal",
                      "koodak",
                      "کودک",
                  ]):
                      return "Persisch | Kinder"

                  if any(x in text for x in [
                      "film",
                      "movie",
                      "cinema",
                      "series",
                      "serial",
                  ]):
                      return "Persisch | Filme & Serien"

       
